OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# Image provider preference: pollinations (free, default), openrouter (paid), or lumen
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux

LUMEN_TOKEN=your-lumen-bearer-token-here
LUMEN_MCP_URL=https://app.lumenpro.io/mcp

# Optional: ElevenLabs narration. Leave key blank to disable audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Supabase (persists stories, scoped per-device until auth is added)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin dashboard — only this email can sign in at /admin/login
ADMIN_EMAIL=admin@example.com

# Phone OTP auth is handled by Supabase Auth. Configure an SMS provider
# (Twilio, Vonage, MessageBird) in: Supabase Dashboard → Auth → Providers → Phone.
# No code-level keys needed here.

# MyFatoorah payment gateway (sandbox by default).
# Live URL: https://api.myfatoorah.com  | Sandbox URL: https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=

# Pricing in KWD (Kuwaiti Dinar). Shown to user; server re-computes from these.
NEXT_PUBLIC_PRICE_BASE_KWD=5.000
NEXT_PUBLIC_PRICE_VOICE_KWD=3.000
NEXT_PUBLIC_PRICE_CHARACTER_KWD=3.000

# Used for MyFatoorah callback URL and links in messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000
